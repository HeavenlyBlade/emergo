rules_version = '2';

// ─── Emergo Firestore Security Rules ─────────────────────────────────────────
//
// Deploy with: firebase deploy --only firestore:rules
// (run from the dashboard/ directory where firebase.json lives)
//
// Two clients share this database:
//   Mobile app  — unauthenticated (no Firebase Auth SDK); uses phone/OTP identity
//   Dashboard   — anonymous Firebase Auth; uses username/password identity
//
// Design principle: mobile operations are open where the OTP flow is the
// security gate. Dashboard reads/writes require Firebase Auth (request.auth != null).

service cloud.firestore {
  match /databases/{database}/documents {

    function isOfficial(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role == 'official';
    }

    function isAdmin(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role == 'admin';
    }

    // ─── incidents ────────────────────────────────────────────────────────────
    // Mobile: residents create incidents without auth (OTP login is the gate).
    // Dashboard: reads and updates require Firebase Auth (anonymous session).

    match /incidents/{incidentId} {
      allow create: if true;           // mobile — OTP-verified resident
      allow read:   if true;           // mobile reads (rate-limit check, subscribeToMyIncidents)
      allow update: if request.auth != null
                    || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['respondersOnTheWay']);
      allow delete: if false;
    }

    // ─── users ───────────────────────────────────────────────────────────────
    // Mobile: residents create and update their own doc without auth.
    // Dashboard: reads require Firebase Auth.

    match /users/{userId} {
      allow read:   if request.auth != null;  // dashboard reads
      allow read:   if true;                  // mobile reads (checkUserExists, getUserDocument)
      allow create: if true;                  // mobile first-login doc creation
      allow update: if true;                  // mobile profile updates (displayName, pushToken)
                                              // role field is never sent by mobile clients
      allow delete: if request.auth != null;     // dashboard admin only (isAdmin is enforced in UI; request.auth.uid is anonymous)
    }

    // ─── otp_codes ───────────────────────────────────────────────────────────
    // Fully open — short-lived codes, brute-force protected in service layer.

    match /otp_codes/{phoneUid} {
      allow read, write, delete: if true;
    }

    // ─── tanod_locations & responder_locations ──────────────────────────────
    // Responders and officials broadcast location.
    // Dashboard and mobile clients read locations.

    match /tanod_locations/{userId} {
      allow write:  if true;
      allow read:   if true;
      allow delete: if false;
    }

    match /responder_locations/{userId} {
      allow write:  if true;
      allow read:   if true;
      allow delete: if false;
    }

    // ─── Default deny ─────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
