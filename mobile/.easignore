# EAS Build archive exclusions
# Prevents EAS from picking up files unnecessary for the build process

node_modules/
.expo/
dist/
web-build/
android/
ios/
.git/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
*.pem
.env*.local
*.tsbuildinfo
.metro-health-check*
.kotlin/
scripts/
.kiro/
.claude/

# Un-ignore — EAS needs these even though git ignores them
!google-services.json
!.env
